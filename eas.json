{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "developmentClient": false,
      "android": {
        "buildType": "apk",
        "autoIncrement": false,
        "env": {
          "NEO_ANDROID_RELEASE": "1"
        }
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": false,
        "env": {
          "NEO_ANDROID_RELEASE": "1"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
