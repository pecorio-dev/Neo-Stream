# Dépôt public du client Neo-stream. Un nouveau dossier reste privé par défaut.
# Pour ajouter une ressource de build, ouvrir son chemin ici puis vérifier `git status`.
*
!/.gitignore
!/README.md
!/LICENSE

# Entrée, dépendances verrouillées et configuration originale du client
!/App.tsx
!/index.ts
!/package.json
!/package-lock.json
!/tsconfig.json
!/eslint.config.js
!/app.json
!/app.config.js
!/eas.json

# Routes et interface Expo / React Native
!/src/
!/src/app/
!/src/app/*.tsx
!/src/app/(tabs)/
!/src/app/(tabs)/*.tsx
!/screens/
!/screens/*.tsx
!/components/
!/components/*.ts
!/components/*.tsx
!/components/phone/
!/components/phone/*.ts
!/components/phone/*.tsx
!/components/tv/
!/components/tv/*.ts
!/components/tv/*.tsx
!/lib/
!/lib/*.ts
!/lib/*.tsx

# Sources Android nécessaires au téléphone et à Android TV. Aucun build généré.
!/plugins/
!/plugins/withAndroidTv.js
!/modules/
!/modules/neo-video-quality/
!/modules/neo-video-quality/expo-module.config.json
!/modules/neo-video-quality/android/
!/modules/neo-video-quality/android/build.gradle
!/modules/neo-video-quality/android/src/
!/modules/neo-video-quality/android/src/main/
!/modules/neo-video-quality/android/src/main/AndroidManifest.xml
!/modules/neo-video-quality/android/src/main/java/
!/modules/neo-video-quality/android/src/main/java/expo/
!/modules/neo-video-quality/android/src/main/java/expo/modules/
!/modules/neo-video-quality/android/src/main/java/expo/modules/neovideoquality/
!/modules/neo-video-quality/android/src/main/java/expo/modules/neovideoquality/NeoVideoQualityModule.kt

# Ressources embarquées par le client et licences des polices
!/assets/
!/assets/icon.png
!/assets/favicon.png
!/assets/splash-icon.png
!/assets/splash-logo.png
!/assets/android-icon-foreground.png
!/assets/android-icon-background.png
!/assets/android-icon-monochrome.png
!/assets/fonts/
!/assets/fonts/*.ttf
!/assets/fonts/OFL.txt
!/assets/fonts/BarlowCondensed-OFL.txt
!/assets/brand/
!/assets/brand/neo_stream_tv_banner.png
!/assets/brand/neo-stream-app-mark.svg
!/assets/brand/neo-stream-header.svg
!/assets/catalogue/
!/assets/catalogue/iptv-directory.json
!/assets/images/
!/assets/images/tt[0-9]*-poster.jpg
!/assets/images/tt[0-9]*-backdrop.jpg
!/assets/images/hero-dune.jpg
!/assets/avatars/
!/assets/avatars/*.png

# Entrée web et visuels GitHub. Le reste de la documentation n'est pas exporté.
!/public/
!/public/index.html
!/public/manifest.json
!/public/app-icon-192.png
!/public/app-icon-512.png
!/docs/
!/docs/v1.0.0.md
!/docs/visuels/
!/docs/visuels/banniere.png
!/docs/visuels/social-preview.png
!/docs/visuels/connexion.png
!/docs/visuels/telephone.png
!/docs/visuels/television.png

# Même dans un chemin rouvert ci-dessus, jamais de secrets ou d'artefacts.
.env
.env.*
.npmrc
credentials.json
local.properties
*.key
*.keystore
*.jks
*.p8
*.p12
*.pem
*.mobileprovision
*.apk
*.aab
*.zip
*.map
*.log
node_modules/
